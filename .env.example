# PostgreSQL connection strings (Neon: Dashboard → your project → Connect).
# Pooled connection, used by the app at runtime (host contains "-pooler"):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by Prisma Migrate (same host without "-pooler"):
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign JWT session cookies (use a different value in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# ---- Email (optional) ----
# Without RESEND_API_KEY no email is sent: with EMAIL_OUTBOX_DIR set, emails are saved there as
# JSON files instead (handy locally); otherwise they're only logged.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Efie Homes <notifications@your-domain.com>"
EMAIL_OUTBOX_DIR=".email-outbox"

# ---- Photo uploads (optional) ----
# On Vercel, connecting a Blob store adds BLOB_READ_WRITE_TOKEN automatically.
# Locally, UPLOADS_DIR stores uploaded photos in a folder instead. With neither, the upload button is hidden.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
UPLOADS_DIR=".uploads"

# Public address used in email links. On Vercel it defaults to the production domain.
# APP_URL="https://your-domain.com"
