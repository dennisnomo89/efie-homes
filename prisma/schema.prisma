// Efie Homes — Prisma schema
// PostgreSQL (hosted on Neon in production).
//   DATABASE_URL           pooled connection, used by the app at runtime (src/lib/prisma.ts)
//   DATABASE_URL_UNPOOLED  direct connection, used by Prisma Migrate (prisma.config.ts)
// These are the variable names Vercel's Neon integration creates automatically.
//
// Enum-like fields (role, propertyType, status, …) are stored as strings and
// validated by the Zod schemas in src/lib/validations.ts. List fields (images,
// amenities) are stored as JSON-encoded strings.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection strings live in prisma.config.ts (migrations) and src/lib/prisma.ts (runtime).
datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String
  /// TENANT | LANDLORD | ADMIN
  role           String   @default("TENANT")
  /// Verified landlords/agents get a trust badge on their listings
  isVerified     Boolean  @default(false)
  /// Bumped to sign the user out everywhere (password change/reset, "sign out everywhere")
  sessionVersion Int      @default(0)
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  properties          Property[]
  viewingRequests     ViewingRequest[]
  savedProperties     SavedProperty[]
  passwordResetTokens PasswordResetToken[]
  messages            Message[]
  savedSearches       SavedSearch[]
  reviewsWritten      Review[]             @relation("ReviewAuthor")
  reviewsReceived     Review[]             @relation("ReviewLandlord")
  listingReports      ListingReport[]
}

model Property {
  id              String   @id @default(cuid())
  title           String
  description     String
  /// CHAMBER_HALL | SINGLE_ROOM_SC | APARTMENT_1BR | APARTMENT_2BR | APARTMENT_3BR | APARTMENT_4BR | DETACHED | TOWNHOUSE | EXECUTIVE_MANSION
  propertyType    String
  /// One of Ghana's 16 regions, e.g. "Greater Accra"
  region          String
  /// Suburb / neighbourhood, e.g. "East Legon"
  neighborhood    String
  address         String
  /// Exact map pin set by the landlord (optional). Shown to the public rounded to ~100 m.
  latitude        Float?
  longitude       Float?
  /// Monthly rent in whole Ghana Cedis
  monthlyRent     Int
  /// Minimum advance the landlord requires, in months (6, 12 or 24)
  advanceMonths   Int      @default(12)
  /// Refundable security deposit in Ghana Cedis
  securityDeposit Int      @default(0)
  /// Agent commission as a percentage of the advance (0 when listed directly by landlord)
  agentFeePercent Int      @default(0)
  bedrooms        Int      @default(1)
  bathrooms       Int      @default(1)
  sizeSqm         Int?
  furnished       Boolean  @default(false)
  /// JSON array of image URLs
  images          String   @default("[]")
  /// JSON array of amenity keys (see src/lib/constants.ts)
  amenities       String   @default("[]")
  /// AVAILABLE | RENTED
  status          String   @default("AVAILABLE")
  isFeatured      Boolean  @default(false)
  /// Hidden by an admin: not shown publicly, still visible to the owner and admins
  isHidden        Boolean  @default(false)
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  landlordId      String
  landlord        User             @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  viewingRequests ViewingRequest[]
  savedBy         SavedProperty[]
  reviews         Review[]
  reports         ListingReport[]

  @@index([region])
  @@index([neighborhood])
  @@index([status])
  @@index([monthlyRent])
  @@index([landlordId])
}

model ViewingRequest {
  id            String   @id @default(cuid())
  preferredDate DateTime
  /// "HH:MM" 24-hour slot
  preferredTime String
  phone         String
  message       String
  /// PENDING | CONFIRMED | DECLINED
  status        String   @default("PENDING")
  landlordNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     User      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages   Message[]
  review     Review?

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
}

/// A message in the private thread attached to a viewing request (tenant ↔ landlord).
model Message {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  /// When the other participant read it
  readAt    DateTime?

  viewingRequestId String
  viewingRequest   ViewingRequest @relation(fields: [viewingRequestId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([viewingRequestId, createdAt])
  @@index([senderId])
}

/// One-time password reset links. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedProperty {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

/// One counted attempt for rate limiting (e.g. a failed login). Old rows are pruned automatically.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// A tenant's saved search. `query` is the normalised filter query string (e.g. "location=Osu&bedrooms=2").
model SavedSearch {
  id             String    @id @default(cuid())
  name           String
  query          String
  emailAlerts    Boolean   @default(true)
  /// Last alert email sent for this search (alerts are throttled)
  lastNotifiedAt DateTime?
  /// When the tenant last opened the results (for "N new" counts)
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([emailAlerts])
}

/// A tenant's review of a landlord after a confirmed viewing that has taken place (one per viewing).
/// Survives deletion of the listing or viewing, so landlords can't erase their history by relisting.
model Review {
  id             String    @id @default(cuid())
  /// 1–5: how the landlord/agent was to deal with
  landlordRating Int
  /// 1–5: how closely the home matched its listing
  accuracyRating Int
  comment        String?
  landlordReply  String?
  repliedAt      DateTime?
  /// Hidden by an admin (abusive or off-topic)
  isHidden       Boolean   @default(false)
  /// Listing title at review time (kept if the listing is deleted)
  propertyTitle  String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  viewingRequestId String?         @unique
  viewingRequest   ViewingRequest? @relation(fields: [viewingRequestId], references: [id], onDelete: SetNull)
  propertyId       String?
  property         Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tenantId         String
  tenant           User            @relation("ReviewAuthor", fields: [tenantId], references: [id], onDelete: Cascade)
  landlordId       String
  landlord         User            @relation("ReviewLandlord", fields: [landlordId], references: [id], onDelete: Cascade)

  @@index([landlordId, isHidden])
  @@index([propertyId])
}

/// A user flags a listing (scam, already rented, wrong details…) for admins to check.
model ListingReport {
  id         String    @id @default(cuid())
  /// SCAM | NOT_AVAILABLE | WRONG_DETAILS | DUPLICATE | OFFENSIVE | OTHER
  reason     String
  details    String?
  /// OPEN | RESOLVED (action taken) | DISMISSED (no problem found)
  status     String    @default("OPEN")
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  /// One report per person per listing; reporting again after it was closed reopens it.
  @@unique([propertyId, reporterId])
  @@index([status, createdAt])
}
